{
  "name": "bakihai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bakihai/web dev",
    "build": "pnpm --filter @bakihai/web build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @bakihai/web test:e2e",
    "deploy:relay": "pnpm --filter @bakihai/relay run deploy",
    "deploy:web": "pnpm --filter @bakihai/web run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2"
  }
}
