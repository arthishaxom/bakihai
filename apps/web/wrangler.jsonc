{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakihai-web",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "bakihai.apothal.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
